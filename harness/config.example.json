{
  "project_name": "My autonomous software",
  "workspace_dir": ".",
  "max_rounds": 6,
  "gates": {
    "compile_cmd": "echo 'compiling...' && exit 0",
    "lint_cmd": "echo 'linting...' && exit 0",
    "test_cmd": "echo 'running tests...' && exit 0",
    "qual_cmd": ""
  },
  "agents": {
    "runner_type": "cli",
    "builder_cmd": "opencode run --auto",
    "reviewer_a_cmd": "opencode run --auto",
    "reviewer_b_cmd": "opencode run --auto",
    "doctor_cmd": "opencode run --auto"
  },
  "inbox": {
    "enabled": true,
    "escalations_dir": ".factory/inbox/escalations",
    "rulings_dir": ".factory/inbox/rulings"
  },
  "delta_convergence": {
    "enabled": true,
    "auto_triage_minor": true,
    "wave_mn_output": ".factory/state/wave_mn.tsv"
  },
  "git": {
    "auto_commit": true,
    "commit_prefix": "checkpoint"
  }
}
